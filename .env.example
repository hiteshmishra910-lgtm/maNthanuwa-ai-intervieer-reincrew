# Copy to `.env` in the project root.

# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Feature Flags (All default to false when absent; set to 'true' to enable in production)
# VITE_INTENT_ENGINE_ENABLED=false
# VITE_CONVERSATION_MEMORY_ENABLED=false
# VITE_ADAPTIVE_PROBING_ENABLED=false
# VITE_BACKGROUND_ENRICHMENT_ENABLED=false
# VITE_NEW_REPORTS_ENABLED=false

# ── Paid API tier (free → paid fallback) ──────────────────────────────────
# Evaluation ALWAYS tries the FREE tier first (VITE_OPENROUTER_API_KEY /
# VITE_GEMINI_API_KEY / openrouter/free). On rate limit (429), quota
# exhaustion, or provider failure, it AUTOMATICALLY switches to the PAID tier.
#
# ⚠️  PAID API KEYS ARE SERVER-SIDE ONLY. Never put a paid key in client env files.
# They live in Supabase Edge Function secrets and are never exposed to candidates.
#
# Server-side paid secrets (Supabase edge function secrets — NOT in this file):
#   supabase secrets set PAID_OPENROUTER_API_KEY=sk-or-v1-...
#   supabase secrets set PAID_GEMINI_API_KEY=AIza...
#   supabase secrets set PAID_MODEL=gemini-2.0-flash
# Every free→paid switch is logged automatically to ai_provider_logs
# (columns provider_tier, fallback_reason).

# Edge function secrets (ALLOWED_ORIGINS, OPENROUTER_API_KEY, CLERK_JWKS_URL, ADMIN_PASSWORD, etc.)
# are configured in the Supabase project — not in this file.
# For local development, you can optionally set:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
